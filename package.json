{
  "name": "flick",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply flick --local",
    "db:migrate:remote": "wrangler d1 migrations apply flick --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "hono": "^4.13.13",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "4.1",
    "wrangler": "^4.151.1"
  }
}
